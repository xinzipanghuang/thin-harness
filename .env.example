# Minimal harness environment configuration (template).
# Copy to .env and fill in your credentials:  cp .env.example .env
# Only four values — every model endpoint needs these, nothing more.

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-chat
LLM_ENABLE_THINKING=false

# Optional WES Center MCP connection. A token is optional only for loopback.
WES_MCP_URL=http://127.0.0.1:9090/mcp
WES_MCP_TOKEN=
WES_MCP_CONNECT_TIMEOUT=5
WES_MCP_CALL_TIMEOUT=120
